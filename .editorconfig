root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx}]
indent_size = 2

[*.{js,css,html}]
indent_size = 2

[*.cs]
# Logging volume is low (no hot paths); LoggerMessage source generation adds noise without benefit here.
dotnet_diagnostic.CA1848.severity = none
# Exe projects: public types are the test surface; internal-by-default adds InternalsVisibleTo noise.
dotnet_diagnostic.CA1515.severity = none
# SQL statements are constant strings with parameters; dynamic parts are fixed column lists, never user input.
dotnet_diagnostic.CA2100.severity = none
# Logging is low-volume (one line per scan); guarding each call adds noise.
dotnet_diagnostic.CA1873.severity = none
