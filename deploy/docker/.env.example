# Copy to .env (which is never committed) and adjust.
# The https:// address users open. Must match the TLS certificate and the redirect URI registered at the IdP.
PUBLIC_ORIGIN=https://dicomlogs.example.internal
# Address the HTTPS port is published on. 127.0.0.1 = this server only (default, remote access off).
# Set to the server's internal (site or VPN/tailnet) address to allow access. Never 0.0.0.0 on an internet-facing host.
PUBLISH_ADDRESS=127.0.0.1
# Your organisation's OpenID Connect identity provider (no application passwords).
OIDC_PROVIDER=oidc
OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<application-client-id>
# Who may use the analyser (checked by the proxy AND by the application). Comma-separated.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_USERS=
# Host folder bind-mounted read-only as /sources/default (add more mounts in compose.yaml).
SOURCES_HOST_DIR=./sources-empty
MAX_UPLOAD_MB=1024
SCAN_INTERVAL_MINUTES=0
